; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Static Horizon FPV Sim"
config/version="0.9.0"
run/main_scene="res://scenes/MainMenu.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7")

[autoload]

InputManager="*res://scenes/InputManager.tscn"
Settings="*res://scripts/settings.gd"
DevPreviewCapture="*res://scripts/dev_preview_capture.gd"
SelfTest="*res://scripts/self_test.gd"
SceneLoader="*res://scripts/scene_loader.gd"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
common/physics_interpolation=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.5, 0.7, 0.9, 1)

[shader_globals]

sh_fog={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
sh_fog_color={
"type": "color",
"value": Color(0.75, 0.82, 0.9, 1)
}
sh_sun={
"type": "vec4",
"value": Vector4(0, -1, 0, 0)
}
sh_sun_color={
"type": "color",
"value": Color(1, 0.97, 0.9, 1)
}
sh_grade={
"type": "vec4",
"value": Vector4(1.08, 1.12, 0, 0)
}
sh_light={
"type": "vec4",
"value": Vector4(0.42, 0.14, 0.5, 0)
}
sh_shadow_r0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sh_shadow_r1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sh_shadow_r2={
"type": "vec4",
"value": Vector4(0, 0, 0, 2)
}
sh_shadow_info={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
sh_shadow_map={
"type": "sampler2D",
"value": ""
}
